# Entity API Configuration
# Copy this file to .env and update values as needed

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./entity.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/entity_db
# For MySQL: mysql+aiomysql://user:password@localhost:3306/entity_db

# Database Echo (log SQL statements)
DB_ECHO=false

# Service Configuration
SERVICE_NAME=entity-api
API_V1_STR=/api/v1
PROJECT_NAME=Entity API

# Logging
LOG_LEVEL=INFO
